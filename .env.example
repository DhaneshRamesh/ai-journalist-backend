DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname?sslmode=require
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-key
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=...AccountName=...AccountKey=...
JOURNALIST_INDEX_CONTAINER=indexes
JOURNALIST_INDEX_BLOB=journalists.faiss
JOURNALIST_META_BLOB=journalists_meta.json
API_PREFIX=/api
ALLOWED_ORIGINS=http://localhost:3000
